---
import '../styles/global.css';
import '../styles/authored.css';
import '../styles/clarity.css';
import '../styles/desk.css';
import '../styles/motion.css';
import Motion from '../components/astro/Motion.astro';
import Nav from '../components/astro/Nav.astro';
import Footer from '../components/astro/Footer.astro';
import JsonLd from '../components/astro/JsonLd.astro';

interface Props {
  title: string;
  description: string;
  url: string;
  ogImage?: string;
  structuredData?: Array<{ type: string; data: Record<string, unknown> }>;
  navVariant?: 'home' | 'inner';
  showSharePrint?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  url,
  ogImage = 'https://samozanyatye.vercel.app/og-image.png',
  structuredData = [],
  navVariant = 'inner',
  showSharePrint = false,
  breadcrumbs = [],
} = Astro.props;

const canonicalUrl = `https://samozanyatye.vercel.app${url}`;
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f2f4ef" />
  <meta name="robots" content={url === "/404" ? "noindex, follow" : "index, follow"} />

  <!-- Раннее применение темы ДО первой отрисовки — предотвращает FOUC -->
  <script is:inline>
    (function(){try{var t=localStorage.getItem('npd-theme');if(t==='dark'){document.documentElement.classList.add('dark');document.querySelector('meta[name="theme-color"]')?.setAttribute('content','#18251f');}}catch(e){}})();
  </script>

  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Icons & manifest -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- Font preloads -->
  <link rel="preload" href="/fonts/lora-cyrillic-400-italic.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/manrope-cyrillic.woff2" as="font" type="font/woff2" crossorigin />

  <!-- JSON-LD structured data -->
  {structuredData.map(item => (
    <JsonLd type={item.type} data={item.data} />
  ))}
</head>
<body class="bg-paper text-ink font-body min-h-dvh flex flex-col antialiased">

  <a href="#main" class="skip-link">Перейти к содержанию</a>

  <Nav variant={navVariant} showSharePrint={showSharePrint} />

  <main class="main flex-1" id="main">
    <slot />
  </main>

  <Footer />
  <Motion />
  <script is:inline>
    document.querySelectorAll('[data-calculator-loading]').forEach(function (group) {
      var pending = Array.from(group.querySelectorAll('astro-island[ssr]'));
      function checkReady() {
        if (!pending.some(function (island) { return island.hasAttribute('ssr'); })) {
          group.disabled = false;
          group.removeAttribute('aria-busy');
          group.removeAttribute('data-calculator-loading');
        }
      }
      pending.forEach(function (island) { island.addEventListener('astro:hydrate', checkReady, {once:true}); });
      checkReady();
    });
  </script>
</body>
</html>
