---
import '../styles/global.css';
import Nav from '../components/astro/Nav.astro';
import Footer from '../components/astro/Footer.astro';
import JsonLd from '../components/astro/JsonLd.astro';

interface Props {
  title: string;
  description: string;
  url: string;
  ogImage?: string;
  structuredData?: Array<{ type: string; data: Record<string, unknown> }>;
  navVariant?: 'home' | 'inner';
  showSharePrint?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  url,
  ogImage = 'https://npd-tools.ru/og-image.png',
  structuredData = [],
  navVariant = 'inner',
  showSharePrint = false,
  breadcrumbs = [],
} = Astro.props;

const canonicalUrl = `https://npd-tools.ru${url}`;
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#6F5DC9" />
  <meta name="robots" content="index, follow" />

  <!-- Раннее применение темы ДО первой отрисовки — предотвращает FOUC -->
  <script is:inline>
    (function(){try{var t=localStorage.getItem('npd-theme');if(t==='dark'){document.documentElement.classList.add('dark');}}catch(e){}})();
  </script>

  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Icons & manifest -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- Font preloads -->
  <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/manrope-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/lora-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Preconnect -->
  <link rel="preconnect" href="https://mc.yandex.ru" />

  <!-- Yandex.Metrika placeholder -->
  <script is:inline data-metrika-placeholder>
    (function(){var ID=window.YANDEX_METRIKA_ID;if(!ID)return;(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,k.setAttribute("data-metrika-id",ID),a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");ym(ID,"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true});})();
  </script>
  <noscript><div><img src="https://mc.yandex.ru/watch/YANDEX_METRIKA_ID" style="position:absolute;left:-9999px" alt="" /></div></noscript>

  <!-- JSON-LD structured data -->
  {structuredData.map(item => (
    <JsonLd type={item.type} data={item.data} />
  ))}
</head>
<body class="bg-paper text-ink font-body min-h-dvh flex flex-col antialiased">
  <a href="#main" class="skip-link">Перейти к содержанию</a>

  <Nav variant={navVariant} showSharePrint={showSharePrint} />

  <main class="main flex-1" id="main">
    <slot />
  </main>

  <Footer />
</body>
</html>
