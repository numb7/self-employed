---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  url: string;
  heading?: string;
  ogImage?: string;
  structuredData?: Array<{ type: string; data: Record<string, unknown> }>;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  url,
  heading = title.split('—')[0].trim(),
  ogImage,
  structuredData = [],
  breadcrumbs = [
    { name: 'Главная', url: '/' },
    { name: title.split(' · ')[0].trim(), url },
  ],
} = Astro.props;

const jsonLd = [
  {
    type: 'BreadcrumbList',
    data: {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.filter(item => item.url !== '/#tasks-anchor').map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        ...(item.url ? { item: `https://samozanyatye.vercel.app${item.url}` } : {}),
      })),
    },
  },
  ...structuredData,
];
---

<BaseLayout
  title={title}
  description={description}
  url={url}
  ogImage={ogImage}
  structuredData={jsonLd}
  navVariant="inner"
  showSharePrint={false}
>
  <header class="page-hero">
    <div class="container">
      <h1 class="page-hero__title font-head" set:html={heading.replace(/`([^`]+)`/, '<em>$1</em>')} />
      <div class="page-hero__subtitle text-muted mt-3 max-w-2xl">
        <slot name="subtitle" />
      </div>
    </div>
  </header>

  <div class="container mt-6 mb-16">
    <div class="calculator-content">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    padding-bottom: 0.5rem;
  }
  .page-hero__title {
    font-size: var(--fs-h1);
    line-height: 1.2;
    color: var(--color-ink);
  }
  .page-hero__subtitle {
    font-size: var(--fs-body);
    line-height: 1.6;
  }
  .page-hero__title :global(em) {
    font-style: italic;
  }
  .calculator-content {
    width: 100%;
    max-width: 56rem;
  }
</style>
