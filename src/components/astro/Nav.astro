---
interface Props {
  variant?: 'home' | 'inner';
  showSharePrint?: boolean;
}

const { variant = 'inner', showSharePrint = false } = Astro.props;
---

<nav class:list={["page-nav", variant === "home" ? "navigation-home" : "navigation-tool"]} aria-label="Основная навигация">
  <div class="container page-nav-inner">
    {variant === 'home' ? (
      <a href="/" class="nav-back nav-brand font-head font-medium text-ink"><span>Самозанятому<span class="brand-suffix">.</span></span></a>
    ) : (
      <a href="/#tools" class="nav-back tool-return text-muted hover:text-ink transition-colors flex items-center gap-1">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
        Все инструменты
      </a>
    )}

    <div class="page-nav-actions flex items-center gap-2">
      {variant === 'home' ? <div class="nav-capsule"><a href="#tools" aria-current="location">Инструменты</a><a href="/poleznoe">Помощь</a></div> : <a href="/" class="nav-quiet-brand">Самозанятому<span>.</span></a>}
      {showSharePrint && (
        <>
          <button class="btn-icon" type="button" data-action="share" aria-label="Поделиться">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
              <polyline points="16 6 12 2 8 6" />
              <line x1="12" y1="2" x2="12" y2="15" />
            </svg>
          </button>
          <button class="btn-icon" type="button" data-action="print" aria-label="Печать">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 6 2 18 2 18 9" />
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
              <rect x="6" y="14" width="12" height="8" />
            </svg>
          </button>
        </>
      )}

      <button id="theme-toggle" class="btn-icon theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="false">
        <svg class="w-5 h-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="w-5 h-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
      </button>
    </div>
  </div>
</nav>
<div id="copy-toast" class="copy-toast" role="status" aria-live="polite" hidden>Ссылка скопирована</div>

<style>
  .page-nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-nav);
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    padding-block: 0.75rem;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .page-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-back {
    font-size: var(--fs-caption);
    font-weight: 600;
    text-decoration: none;
  }
  .nav-brand {
    font-size: 18px;
    display:flex;align-items:center;gap:9px;letter-spacing:-0.04em;
  }
  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }
  .btn-icon:hover {
    color: var(--color-ink);
    border-color: var(--color-line-2);
  }
  .theme-toggle {
    color: var(--color-ink);
  }
  .copy-toast {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: var(--z-toast);
    padding: 10px 14px;
    border-radius: var(--radius-card);
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: var(--shadow-elevated);
    font-size: var(--fs-caption);
    font-weight: 600;
  }

  .brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:var(--color-accent);color:white;font-weight:700}
  .brand-suffix{font-weight:400}.nav-tools-link,.nav-method-link{font-size:12px;display:flex;align-items:center;min-height:44px;padding-inline:12px;color:var(--color-ink)}
  .btn-icon{border-radius:50%;border-color:var(--color-line)}
  @media(max-width:650px){.nav-method-link{display:none}.nav-tools-link{font-size:11px;padding-inline:5px}.nav-brand{font-size:15px}.page-nav-actions{gap:5px}}
</style>

<script is:inline>
(function() {
  var btn = document.getElementById('theme-toggle');
  if (!btn) return;
  btn.setAttribute('aria-pressed', document.documentElement.classList.contains('dark') ? 'true' : 'false');
  btn.addEventListener('click', function() {
    var html = document.documentElement;
    var isDark = html.classList.toggle('dark');
    btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isDark ? '#121a30' : '#ffffff');
    try {
      localStorage.setItem('npd-theme', isDark ? 'dark' : 'light');
    } catch(e) {}
  });

  function updateSection() {
    var target = window.location.hash === '#home-tax' ? '#home-tax' : '#tools';
    document.querySelectorAll('.nav-capsule a').forEach(function(link) {
      if (link.getAttribute('href') === target) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }
  updateSection();
  window.addEventListener('hashchange', updateSection);

  // Share button
  var shareBtn = document.querySelector('[data-action="share"]');
  var copyToast = document.getElementById('copy-toast');
  var toastTimer;
  function showCopyToast() {
    if (!copyToast) return;
    copyToast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function() { copyToast.hidden = true; }, 1800);
  }
  if (shareBtn && navigator.share) {
    shareBtn.addEventListener('click', function() {
      navigator.share({
        title: document.title,
        url: window.location.href
      }).catch(function() {});
    });
  } else if (shareBtn) {
    shareBtn.addEventListener('click', function() {
      navigator.clipboard.writeText(window.location.href).then(function() {
        showCopyToast();
      });
    });
    shareBtn.style.display = '';
  }

  // Print button
  var printBtn = document.querySelector('[data-action="print"]');
  if (printBtn) {
    printBtn.addEventListener('click', function() { window.print(); });
  }
})();
</script>
