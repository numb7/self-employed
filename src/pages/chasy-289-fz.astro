---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { Chasy289Calculator } from '../components/react/calculators/Chasy289Calculator';

const title = 'Часы работы через цифровую платформу — проверка критерия 2026';
const description = 'Проверка двух числовых условий работы через платформу: часов и последовательных месяцев. Не устанавливает полную применимость специальной нормы.';
const url = '/chasy-289-fz';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Часы по 289-ФЗ' },
];


---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  heading="Работаю через платформу — что проверить?"
  breadcrumbs={breadcrumbs}
>
  <p class="text-muted" slot="subtitle">
    Проверим только сочетание часов и последовательных месяцев: больше 60 часов в каждом месяце
    у одного заказчика не менее 6 месяцев подряд. Полную применимость специальной нормы этот расчёт не устанавливает.
  </p>

  <section class="mt-8">
    <fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Инструмент расчёта"><Chasy289Calculator client:load /></fieldset><noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript>
  </section>
</CalculatorLayout>
