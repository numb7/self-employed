---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { Chasy289Calculator } from '../components/react/calculators/Chasy289Calculator';
import RelatedTools from '../components/astro/RelatedTools.astro';

const title = 'Часы работы через цифровую платформу — проверка критерия 2026';
const description = 'Проверьте критерий продолжительности работы через посредническую цифровую платформу: больше 60 часов в месяц у одного заказчика в течение 6 месяцев подряд.';
const url = '/chasy-289-fz';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Часы по 289-ФЗ' },
];

const structuredData = [{
  type: 'FAQPage' as const,
  data: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Сколько часов самозанятый может работать на одного заказчика?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Для исполнителей на посреднических цифровых платформах учитывается работа больше 60 часов в месяц у одного заказчика в течение 6 месяцев подряд.',
        },
      },
      {
        '@type': 'Question',
        name: 'Что будет, если превысить лимит часов?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Это один из критериев систематичности работы через платформу, а не автоматическая переквалификация отношений в трудовые.',
        },
      },
    ],
  },
}];

const relatedTools = [
  { title: 'Риск переквалификации', description: 'Оценка риска трудовых отношений', url: '/risk-trudovyh' },
  { title: 'Зависимость от заказчика', description: 'Доля дохода от крупнейшего клиента', url: '/koncentracia-dohoda' },
  { title: 'Мастер выбора режима', description: 'Подберёт оптимальный режим', url: '/master-vybora-rezhima' },
];
---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p class="text-muted" slot="subtitle">
    Для исполнителей на посреднических цифровых платформах проверяется работа больше 60 часов в месяц
    у одного заказчика в течение 6 месяцев подряд. Это не общий лимит для всех самозанятых.
  </p>

  <section class="mt-8">
    <Chasy289Calculator client:load />
  </section>

  <section class="mt-10">
    <details class="group">
      <summary class="cursor-pointer font-head text-sm font-medium text-muted hover:text-ink transition-colors select-none">
        Как считается: откуда цифры
      </summary>
      <div class="prose mt-4 text-sm">
        <p>289-ФЗ регулирует платформенную экономику. Критерий продолжительности применяется к партнёрам-исполнителям посреднических цифровых платформ: больше 60 часов в месяц у одного заказчика в течение 6 месяцев подряд.</p>
        <p>Расчёт ориентировочный. <a href="/metodika">Подробнее о методике →</a></p>
        <ul class="mt-2">
          <li><a href="https://www.consultant.ru/document/cons_doc_LAW_511088/" target="_blank" rel="noopener noreferrer">ФЗ № 289-ФЗ от 31.07.2025</a> — регулирование платформенной экономики</li>
          <li><a href="https://www.consultant.ru/law/hotdocs/94591.html" target="_blank" rel="noopener noreferrer">Постановление Правительства РФ № 760</a> — критерий 60 часов и 6 месяцев</li>
        </ul>
      </div>
    </details>
  </section>

  <RelatedTools tools={relatedTools} currentUrl={url} />
</CalculatorLayout>
