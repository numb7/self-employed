---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { HourlyRateCalculator } from '../components/react/calculators/HourlyRateCalculator';
import RelatedTools from '../components/astro/RelatedTools.astro';

const title = 'Ставка в час для самозанятого — калькулятор 2026';
const description = 'Сколько просить за проект, чтобы выйти на желаемый доход — и сколько вы реально получаете в час с учётом всех правок и переписок. Калькулятор для самозанятых.';
const url = '/stavka-v-chas';
const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Ставка в час' },
];

const structuredData = [
  {
    type: 'FAQPage' as const,
    data: {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Как посчитать свою ставку в час как самозанятому?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Разделите желаемый чистый доход за месяц на количество рабочих часов. Затем учтите налог НПД (4% с физлиц, 6% с юрлиц) — добавьте его к сумме, которую нужно выставить заказчику.',
          },
        },
        {
          '@type': 'Question',
          name: 'Как учесть скрытые часы — правки, переписки, созвоны?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Используйте режим «Сколько реально получаю»: введите оплату за проект и реально потраченные часы (включая правки и переписки). Калькулятор покажет реальную часовую ставку после налога.',
          },
        },
        {
          '@type': 'Question',
          name: 'Какая ставка НПД для расчёта?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: '4% — если деньги приходят от физлиц, 6% — если от юрлиц или ИП. Выберите тип заказчика в калькуляторе, чтобы расчёт был точным.',
          },
        },
      ],
    },
  },
];

const relatedTools = [
  { title: 'Отложить на налог', description: 'Сколько отложить с каждой оплаты', url: '/otlozhit-na-nalog' },
  { title: 'Лимит дохода', description: 'Сколько ещё можно заработать до конца года', url: '/limit-dohoda' },
  { title: 'Договор и акт', description: 'Шаблон договора оказания услуг и акта', url: '/dogovor-akt' },
];
---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  eyebrow="Ставка · 2026"
  heading="Какую цену назвать клиенту?"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p slot="subtitle">
    Укажите желаемый доход и рабочие часы. Если проект уже завершён, можно проверить, сколько принёс каждый час.
  </p>

  <section class="mt-8">
    <fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Инструмент расчёта"><HourlyRateCalculator client:load /></fieldset><noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript>
  </section>



  <RelatedTools tools={relatedTools} currentUrl={url} />
</CalculatorLayout>
