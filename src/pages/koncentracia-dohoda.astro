---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { ConcentrationTracker } from '../components/react/calculators/ConcentrationTracker';
import RelatedTools from '../components/astro/RelatedTools.astro';

const title = 'Зависимость от одного заказчика — проверка для самозанятого';
const description = 'Проверьте, не слишком ли вы зависите от одного заказчика. >=70% дохода от одного источника дольше 6 месяцев — признак риска переквалификации в трудовые.';
const url = '/koncentracia-dohoda';
const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Зависимость от заказчика' },
];

const structuredData = [
  {
    type: 'WebPage' as const,
    data: {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: 'https://samozanyatye.vercel.app/koncentracia-dohoda',
    },
  },
];

const relatedTools = [
  { title: 'Договор и акт', description: 'Шаблон договора оказания услуг и акта', url: '/dogovor-akt' },
  { title: 'Самозанятый или ИП', description: 'Сравните налоговую нагрузку НПД и ИП', url: '/ip-ili-samozanyatyy' },
  { title: 'Лимит дохода', description: 'Сколько ещё можно заработать до конца года', url: '/limit-dohoda' },
];
---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  heading="Зависимость от одного заказчика"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p slot="subtitle">
    Посчитайте, какая доля дохода приходится на крупнейшего заказчика. Большая доля сама по себе
    не означает нарушение, но помогает заметить финансовую зависимость и проверить условия работы.
  </p>

  <section class="mt-8">
    <ConcentrationTracker client:load />
  </section>

  <section class="mt-10">
    <details class="group rounded-[var(--radius-card)] border border-line bg-surface" open>
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-ink select-none">
        Что именно считается риском и почему?
      </summary>
      <div class="px-4 pb-4 text-sm text-muted leading-relaxed">
        Калькулятор показывает финансовую зависимость от крупнейшего заказчика. Для оценки трудовых
        отношений одного процента недостаточно: проверяют договор, контроль графика, характер оплаты
        и другие обстоятельства в совокупности.
      </div>
    </details>

    <details class="group rounded-[var(--radius-card)] border border-line bg-surface mt-2">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-ink select-none">
        Как снизить риск переквалификации?
      </summary>
      <div class="px-4 pb-4 text-sm text-muted leading-relaxed">
        <ul class="list-disc list-inside space-y-1">
          <li>Распределяйте доход между заказчиками (не более 70% от одного)</li>
          <li>Оформляйте письменные договоры с чётким описанием результата</li>
          <li>Избегайте постоянного графика и расписания</li>
          <li>Используйте собственные инструменты и оборудование</li>
          <li>Делайте перерывы в отношениях с одним заказчиком</li>
        </ul>
      </div>
    </details>
  </section>

  <RelatedTools tools={relatedTools} currentUrl={url} />
</CalculatorLayout>
