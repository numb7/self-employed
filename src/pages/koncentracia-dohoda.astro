---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { ConcentrationTracker } from '../components/react/calculators/ConcentrationTracker';

const title = 'Зависимость от одного заказчика — проверка для самозанятого';
const description = 'Проверьте, не слишком ли вы зависите от одного заказчика. Доля дохода и срок работы помогают оценить зависимость. Это ориентир, а не юридическое заключение.';
const url = '/koncentracia-dohoda';
const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Зависимость от заказчика' },
];

const structuredData = [
  {
    type: 'WebPage' as const,
    data: {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: 'https://samozanyatye.vercel.app/koncentracia-dohoda',
    },
  },
];

---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  heading="Зависимость от одного заказчика"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p slot="subtitle">
    Посчитайте, какая доля дохода приходится на крупнейшего заказчика. Большая доля сама по себе
    не означает нарушение, но помогает заметить финансовую зависимость и проверить условия работы.
  </p>

  <section class="mt-8">
    <fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Инструмент расчёта"><ConcentrationTracker client:load /></fieldset><noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript>
  </section>

  <section class="mt-10">
    <details class="group rounded-[var(--radius-card)] border border-line bg-surface" open>
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-ink select-none">
        Что показывает доля одного заказчика?
      </summary>
      <div class="px-4 pb-4 text-sm text-muted leading-relaxed">
        Калькулятор показывает финансовую зависимость от крупнейшего заказчика. Для оценки трудовых
        отношений одного процента недостаточно: проверяют договор, контроль графика, характер оплаты
        и другие обстоятельства в совокупности.
      </div>
    </details>

    <details class="group rounded-[var(--radius-card)] border border-line bg-surface mt-2">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-ink select-none">
        Что делать, если один заказчик приносит большую часть дохода?
      </summary>
      <div class="px-4 pb-4 text-sm text-muted leading-relaxed">
        <p>Для планирования денег оцените, как изменится ваш доход, если этот заказчик сократит заказы. Подумайте о резерве и поиске других клиентов.</p>
        <p class="mt-3">Это финансовые решения. Доля ниже 70% или перерывы между заказами сами по себе не подтверждают, что отношения не являются трудовыми. Важны договор и то, как работа устроена на деле.</p>
        <p class="mt-3">Если заказчик управляет вашей работой как работодатель, обсудите фактические условия с юристом. Изменение формулировок договора не заменяет изменение самих отношений.</p>
        <a class="mt-3 inline-block" href="https://www.nalog.gov.ru/rn25/ifns/r25_17/info/15503663/" target="_blank" rel="noopener noreferrer">Как ФНС оценивает отношения с заказчиком ↗</a>
      </div>
    </details>
  </section>
</CalculatorLayout>
