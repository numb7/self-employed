---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { ContractGenerator } from '../components/react/calculators/ContractGenerator';

const title = 'Договор и акт для самозанятого — шаблон 2026';
const description = 'Подготовьте текст шаблона договора оказания услуг или акта: данные сторон, согласованные сроки, оплата и приёмка. Проверка перед подписанием обязательна.';
const url = '/dogovor-akt';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Договор и акт' },
];


---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  breadcrumbs={breadcrumbs}
  heading="Подготовить договор или акт"
>
  <p class="text-muted" slot="subtitle">
    Укажите данные и согласованные условия — получите текст шаблона договора или акта для проверки.
    Можно скопировать текст или скачать файл.
  </p>

  <section class="mt-8">
    <fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Инструмент расчёта"><ContractGenerator client:load /></fieldset><noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript>
  </section>

  <section class="mt-10">
    <details class="group">
      <summary class="cursor-pointer font-head text-sm font-medium text-muted hover:text-ink transition-colors select-none">
        Для кого этот шаблон
      </summary>
      <div class="prose mt-4 text-sm">
        <p>Генератор собирает ограниченный шаблон оказания услуг для исполнителя на НПД. Он не проверяет статус исполнителя, полномочия подписантов и соответствие документа конкретной сделке. Для подряда, передачи авторских прав и специальных видов услуг могут требоваться другие условия.</p>
        <p>Шаблон носит справочный характер и требует проверки под конкретную сделку. Он не заменяет юридическую консультацию.</p>
        <ul class="mt-2">
          <li>ФЗ № 422-ФЗ — статус самозанятого</li>
          <li><a href="https://www.consultant.ru/document/cons_doc_LAW_9027/a397ec4ca2dd0c96c211ee4e4436628f0cf581a3/" target="_blank" rel="noopener noreferrer">Статья 779 ГК РФ — оказание услуг</a></li><li><a href="https://www.consultant.ru/document/cons_doc_LAW_9027/2db588b17543c1f6e0ce72c2f3d04f219c0503a7/" target="_blank" rel="noopener noreferrer">Статья 781 ГК РФ — согласованные сроки и порядок оплаты</a></li>
        </ul>
      </div>
    </details>
  </section>
</CalculatorLayout>
