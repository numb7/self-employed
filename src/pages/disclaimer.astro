---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Ограничение ответственности';
const description = 'Результаты справочные и ориентировочные. Не являются налоговой, юридической, бухгалтерской или финансовой консультацией.';
const url = '/disclaimer';

const structuredData = [{
  type: 'WebPage',
  data: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://samozanyatye.vercel.app/disclaimer',
    url: 'https://samozanyatye.vercel.app/disclaimer',
    name: title,
    description,
    dateModified: '2026-07-18',
  },
}];
---

<BaseLayout
  title={title}
  description={description}
  url={url}
  structuredData={structuredData}
  navVariant="inner"
>
  <div class="container pb-16">
    <div class="pt-8">
      <span class="inline-block rounded-[var(--radius-badge)] bg-lavender-2 px-2.5 py-1 text-xs font-medium text-accent uppercase tracking-wider">
        Дисклеймер · 2026
      </span>
      <h1 class="mt-4 font-head text-[var(--fs-h1)] font-medium text-ink">Ограничение ответственности</h1>
      <p class="mt-2 text-muted">Прежде чем доверять цифрам — прочитайте, что именно они показывают и чего не учитывают.</p>
    </div>

    <div class="mt-8 flex flex-col gap-3">
      <details class="group rounded-[var(--radius-card)] border border-line bg-surface" open>
        <summary class="cursor-pointer px-5 py-4 font-head text-sm font-medium text-ink hover:text-accent transition-colors select-none">
          Результаты справочные и ориентировочные
        </summary>
        <div class="px-5 pb-4 text-sm text-muted leading-relaxed">
          Все расчёты на сайте носят справочный и ориентировочный характер. Калькуляторы используют нормативные параметры актуального года, но не учитывают индивидуальные особенности вашей ситуации.
        </div>
      </details>

      <details class="group rounded-[var(--radius-card)] border border-line bg-surface" open>
        <summary class="cursor-pointer px-5 py-4 font-head text-sm font-medium text-ink hover:text-accent transition-colors select-none">
          Не являются консультацией
        </summary>
        <div class="px-5 pb-4 text-sm text-muted leading-relaxed">
          Результаты не являются налоговой, юридической, бухгалтерской или финансовой консультацией. Сервис не заменяет консультацию специалиста и не предоставляет профессиональных рекомендаций.
        </div>
      </details>

      <details class="group rounded-[var(--radius-card)] border border-line bg-surface" open>
        <summary class="cursor-pointer px-5 py-4 font-head text-sm font-medium text-ink hover:text-accent transition-colors select-none">
          Сверяйте с официальными источниками
        </summary>
        <div class="px-5 pb-4 text-sm text-muted leading-relaxed">
          Данные необходимо сверять с официальными источниками:
          <ul class="mt-2 list-disc list-inside flex flex-col gap-1.5">
            <li><a href="https://www.nalog.gov.ru/rn77/program/" target="_blank" rel="noopener noreferrer">Приложение «Мой налог»</a> — точный расчёт налога НПД</li>
            <li><a href="https://sfr.gov.ru/" target="_blank" rel="noopener noreferrer">СФР</a> — расчёт больничных и пенсионных взносов</li>
            <li><a href="https://gosuslugi.ru/" target="_blank" rel="noopener noreferrer">Госуслуги</a> — государственные услуги</li>
          </ul>
        </div>
      </details>

      <details class="group rounded-[var(--radius-card)] border border-line bg-surface" open>
        <summary class="cursor-pointer px-5 py-4 font-head text-sm font-medium text-ink hover:text-accent transition-colors select-none">
          Индивидуальная ситуация
        </summary>
        <div class="px-5 pb-4 text-sm text-muted leading-relaxed">
          Расчёт может не подходить к вашей индивидуальной ситуации. Параметры (ставки, лимиты, взносы) могут изменяться. Калькуляторы не учитывают региональные льготы, патентные системы, наличие сотрудников, расходы и другие факторы, влияющие на итоговую налоговую нагрузку.
        </div>
      </details>

      <details class="group rounded-[var(--radius-card)] border border-line bg-surface" open>
        <summary class="cursor-pointer px-5 py-4 font-head text-sm font-medium text-ink hover:text-accent transition-colors select-none">
          Обращение к специалисту
        </summary>
        <div class="px-5 pb-4 text-sm text-muted leading-relaxed">
          При существенных суммах, спорных ситуациях, сложных сделках или нестандартных условиях работы рекомендуется обратиться к квалифицированному специалисту — налоговому консультанту, бухгалтеру или юристу.
        </div>
      </details>
    </div>

    <section class="mt-10">
      <h2 class="font-head text-sm font-semibold text-ink">Документы</h2>
      <div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3">
        <a href="/metodika" class="rounded-[var(--radius-card)] border border-line bg-surface p-4 hover:bg-lavender transition-colors">
          <span class="text-sm font-medium text-ink">Методика и источники</span>
          <span class="mt-1 block text-xs text-muted">Откуда цифры в калькуляторах</span>
        </a>
        <a href="/privacy" class="rounded-[var(--radius-card)] border border-line bg-surface p-4 hover:bg-lavender transition-colors">
          <span class="text-sm font-medium text-ink">Конфиденциальность</span>
          <span class="mt-1 block text-xs text-muted">Как обрабатываются данные</span>
        </a>
        <a href="/" class="rounded-[var(--radius-card)] border border-line bg-surface p-4 hover:bg-lavender transition-colors">
          <span class="text-sm font-medium text-ink">Все калькуляторы</span>
          <span class="mt-1 block text-xs text-muted">Вернуться на главную</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
