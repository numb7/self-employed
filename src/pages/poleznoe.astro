---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
const title = 'Самозанятость простыми словами — вопросы и ответы';
const description = 'Короткие ответы о налоге, чеках, бонусе и лимите дохода. Ссылки на официальные источники.';
const faqs = [
 {q:'Мне заплатили. Что нужно сделать?',a:'Проверьте, оформлен ли чек. Если банк или платформа не сделали это за вас, создайте его в «Мой налог» или подключённом сервисе и передайте заказчику. Договор или акт чек не заменяет.'},
 {q:'Какой срок выдачи чека?',a:'При наличных и электронных средствах платежа чек передают в момент расчёта. При иных безналичных расчётах — не позднее 9-го числа следующего месяца. Если чек уже сформирован подключённым сервисом, дублировать его не нужно.'},
 {q:'Мне перевели аванс. Нужен чек?',a:'Да, предоплату за работу тоже отражают как доход. Оформите чек на полученную сумму. При окончательном расчёте не учитывайте один и тот же аванс повторно.'},
 {q:'В чеке ошибка или я вернул деньги. Что делать?',a:'Исправление выполняется в «Мой налог» или подключённом сервисе. Ошибочный чек аннулируют и создают корректный. Для возврата используют основание «Возврат средств». Этот помощник не меняет сведения в ФНС.'},
 {q:'Нужно самому считать налог?',a:'Итоговый налог считает ФНС по оформленным чекам. Наш калькулятор нужен для предварительной оценки: сколько денег оставить с одной оплаты.'},
 {q:'Почему налог бывает разным?',a:'За оплату от человека ставка составляет 4%, от компании или ИП — 6%. Пока есть налоговый бонус, сумма будет меньше.'},
 {q:'Бонус 10 000 ₽ — это деньги на карту?',a:'Нет. Это разовая скидка на налог. Она расходуется постепенно и применяется автоматически. Остаток можно проверить в «Мой налог».'},
 {q:'Когда платить?',a:'Обычно до 28-го числа следующего месяца. Если день нерабочий, срок переносится на следующий рабочий день. У первой оплаты налога после регистрации есть особенности — ориентируйтесь на начисление и срок в «Мой налог».'},
 {q:'Можно получать больше 200 000 ₽ в месяц?',a:'Отдельного месячного лимита нет. Важна общая сумма дохода от самозанятости за календарный год: не больше 2,4 млн ₽.'},
 {q:'Что делать, если доход превысит лимит?',a:'С даты превышения применять НПД нельзя. Дальнейшие действия зависят от того, есть ли у вас статус ИП и какой режим вам подходит. До следующей оплаты уточните порядок в ФНС.'},
 {q:'Этот сайт отправляет данные в налоговую?',a:'Нет. Калькуляторы оценивают суммы на вашем устройстве. Чек, начисленный налог и его оплату проверяйте в «Мой налог» или подключённом сервисе.'},
];
const structuredData = [{type:'FAQPage',data:{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}}];
---
<CalculatorLayout title={title} description={description} url="/poleznoe" heading="Вопросы о самозанятости" structuredData={structuredData}>
  <p slot="subtitle">Налог, чеки и лимит дохода — ответы на повседневные вопросы.</p>
  <section class="plain-faq" aria-label="Вопросы о самозанятости">{faqs.map(f=><details><summary>{f.q}<span aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}</section>
  <p class="plain-faq-sources">О сроках чеков: <a href="https://www.nalog.gov.ru/rn72/news/tax_doc_news/16629318/" target="_blank" rel="noopener noreferrer">ФНС</a>. Об исправлении: <a href="https://www.nalog.gov.ru/rn19/news/activities_fts/16641019/" target="_blank" rel="noopener noreferrer">ФНС</a>. Основные правила: <a href="https://npd.nalog.ru/" target="_blank" rel="noopener noreferrer">сайт ФНС</a>. О дате утраты права на НПД: <a href="https://www.nalog.gov.ru/rn91/news/tax_doc_news/8485686/" target="_blank" rel="noopener noreferrer">разъяснение ФНС</a>. <a href="/metodika">Как устроены наши расчёты ↗</a></p>
</CalculatorLayout>
