---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { DeductionCalculator } from '../components/react/calculators/DeductionCalculator';

const title = 'Вычет 10 000 ₽ — калькулятор налогового вычета самозанятого 2026';
const description = 'Рассчитайте, сколько вы экономите на налоге с вычетом 10 000 ₽, и сколько осталось. Ставка снижается: 4% → 3% с физлиц, 6% → 4% с юрлиц.';
const url = '/vychet-10000';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Вычет 10 000 ₽' },
];

const structuredData = [{
  type: 'FAQPage' as const,
  data: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Что такое вычет 10 000 ₽ для самозанятых?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Единовременный налоговый вычет при регистрации самозанятого. Снижает ставку НПД: 4% → 3% с физлиц и 6% → 4% с юрлиц, пока суммарная экономия не достигнет 10 000 ₽.',
        },
      },
      {
        '@type': 'Question',
        name: 'Когда заканчивается вычет?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Вычет исчерпывается, когда суммарная экономия достигает 10 000 ₽. После этого ставки возвращаются к стандартным: 4% с физлиц и 6% с юрлиц.',
        },
      },
    ],
  },
}];

---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  heading="Сколько налогового бонуса осталось?"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
  showSharePrint
>
  <p class="text-muted" slot="subtitle">
    При регистрации дают скидку на налог — до 10 000 ₽ за всё время самозанятости. Она расходуется постепенно. Посчитайте примерный остаток.
  </p>

  <section class="mt-8">
    <fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Инструмент расчёта"><DeductionCalculator client:load /></fieldset><noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript>
  </section>
</CalculatorLayout>
