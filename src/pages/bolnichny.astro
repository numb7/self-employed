---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { ContributionCalculator } from '../components/react/calculators/ContributionCalculator';
import { DeductionCalculator } from '../components/react/calculators/DeductionCalculator';
import RelatedTools from '../components/astro/RelatedTools.astro';

const title = 'Взносы на больничный и налоговый вычет — калькулятор самозанятого 2026';
const description = 'Рассчитайте стоимость взносов на социальное страхование (тариф 2,9%, скидки со 2-го года) и налоговый вычет 10 000 ₽ для самозанятых.';
const url = '/bolnichny';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Взносы и вычеты' },
];

const structuredData = [{
  type: 'FAQPage' as const,
  data: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Сколько платит самозанятый за больничный?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '2,9% от выбранной страховой суммы в месяц. Со скидкой 10% с 19-го месяца и 30% с 25-го.',
        },
      },
      {
        '@type': 'Question',
        name: 'Обязательны ли взносы для самозанятых?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Нет, взносы на больничный — добровольные для самозанятых (НПД). Но без них нет больничных пособий.',
        },
      },
      {
        '@type': 'Question',
        name: 'Что такое налоговый вычет 10 000 ₽?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Единовременный вычет снижает ставку НПД: 4% → 3% с физлиц и 6% → 4% с юрлиц, пока суммарная экономия не достигнет 10 000 ₽.',
        },
      },
    ],
  },
}];

const relatedTools = [
  { title: 'Пенсионный стаж', description: 'Стоимость 1 года стажа', url: '/pensiya' },
  { title: 'Сколько налога заплатить', description: 'Отложить с каждой оплаты', url: '/otlozhit-na-nalog' },
  { title: 'ИП или самозанятый', description: 'Сравнение нагрузки', url: '/ip-ili-samozanyatyy' },
];
---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p class="text-muted" slot="subtitle">
    Самозанятые могут добровольно платить взносы на социальное страхование — тогда будет больничное пособие.
    Страховую сумму выбираете сами.
  </p>

  <section class="mt-8">
    <ContributionCalculator client:load />
  </section>

  <section class="mt-10">
    <h2 class="font-head text-lg font-semibold text-ink">Налоговый вычет 10 000 ₽</h2>
    <p class="mt-1 text-sm text-muted">Единовременная льгота при регистрации самозанятого. Снижает ставку на 1–2 п.п., пока не исчерпается.</p>
    <div class="mt-4">
      <DeductionCalculator client:visible />
    </div>
  </section>

  <section class="mt-10">
    <details class="group">
      <summary class="cursor-pointer font-head text-sm font-medium text-muted hover:text-ink transition-colors select-none">
        Как считается: откуда цифры
      </summary>
      <div class="prose mt-4 text-sm">
        <p><strong>Взносы:</strong> добровольные. Тариф: 2,9% от выбранной страховой суммы. Скидки: 10% с 19-го месяца, 30% с 25-го месяца непрерывной уплаты. Пособие: 70% от страховой суммы при стаже ≤6 мес., 100% — при стаже &gt;12 мес.</p>
        <p><strong>Вычет:</strong> единовременный налоговый вычет 10 000 ₽ уменьшает ставку: на 1 п.п. от доходов физлиц (4% → 3%) и на 2 п.п. от доходов юрлиц/ИП (6% → 4%). Исчерпывается при достижении экономии 10 000 ₽.</p>
        <p>Расчёт ориентировочный. <a href="/metodika">Подробнее о методике →</a></p>
        <ul class="mt-2">
          <li>ФЗ № 456-ФЗ, ст. 5 — тариф добровольного страхования</li>
          <li>Постановление Правительства № 1467 — порядок уплаты</li>
        </ul>
      </div>
    </details>
  </section>

  <RelatedTools tools={relatedTools} currentUrl={url} />
</CalculatorLayout>
