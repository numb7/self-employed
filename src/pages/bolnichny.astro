---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { ContributionCalculator } from '../components/react/calculators/ContributionCalculator';
import RelatedTools from '../components/astro/RelatedTools.astro';

const title = 'Взносы на больничный для самозанятых — калькулятор 2026';
const description = 'Рассчитайте добровольные взносы на больничный для самозанятых: страховая сумма 35 000 ₽ или 50 000 ₽, тариф 3,84%.';
const url = '/bolnichny';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Взносы на больничный' },
];

const structuredData = [{
  type: 'FAQPage' as const,
  data: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Сколько платит самозанятый за больничный?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '3,84% от страховой суммы: 1 344 ₽ в месяц для 35 000 ₽ или 1 920 ₽ для 50 000 ₽.',
        },
      },
      {
        '@type': 'Question',
        name: 'Обязательны ли взносы для самозанятых?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Нет, взносы на больничный — добровольные для самозанятых (НПД). Но без них нет больничных пособий.',
        },
      },
    ],
  },
}];

const relatedTools = [
  { title: 'Пенсионный стаж', description: 'Стоимость 1 года стажа', url: '/pensiya' },
  { title: 'Сколько налога заплатить', description: 'Отложить с каждой оплаты', url: '/otlozhit-na-nalog' },
  { title: 'ИП или самозанятый', description: 'Сравнение нагрузки', url: '/ip-ili-samozanyatyy' },
];
---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p class="text-muted" slot="subtitle">
    Самозанятые могут добровольно платить взносы на социальное страхование — тогда будет больничное пособие.
    Страховую сумму выбираете сами.
  </p>

  <section class="mt-8">
    <ContributionCalculator client:load />
  </section>

  <section class="mt-10">
    <details class="group">
      <summary class="cursor-pointer font-head text-sm font-medium text-muted hover:text-ink transition-colors select-none">
        Как считается: откуда цифры
      </summary>
      <div class="prose mt-4 text-sm">
        <p>Взносы добровольные. Тариф — 3,84% от выбранной страховой суммы: 35 000 ₽ или 50 000 ₽. Право на пособие появляется после 6 месяцев непрерывной уплаты.</p>
        <p>После 6 месяцев для расчёта используется 70% страховой суммы, после 12 месяцев — 100%. Фактическая выплата зависит от страхового стажа и продолжительности больничного.</p>
        <p>Расчёт ориентировочный. <a href="/metodika">Подробнее о методике →</a></p>
        <ul class="mt-2">
          <li><a href="https://sfr.gov.ru/branches/kchr/news~2026/01/21/278268" target="_blank" rel="noopener noreferrer">СФР: условия эксперимента и размеры взносов</a></li>
          <li>ФЗ № 456-ФЗ — эксперимент по добровольному социальному страхованию</li>
        </ul>
      </div>
    </details>
  </section>

  <RelatedTools tools={relatedTools} currentUrl={url} />
</CalculatorLayout>
