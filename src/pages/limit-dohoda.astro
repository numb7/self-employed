---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { IncomeLimitCalculator } from '../components/react/calculators/IncomeLimitCalculator';

const title = 'Калькулятор лимита дохода самозанятого в 2026 году';
const description = 'Рассчитайте остаток годового лимита НПД и прогноз при указанном месячном доходе. Период прогноза выбираете вы.';
const url = '/limit-dohoda';
const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Лимит дохода' },
];

const structuredData = [
  {
    type: 'FAQPage' as const,
    data: {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Какой лимит дохода у самозанятого в 2026 году?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: '2 400 000 рублей за календарный год. После превышения применять НПД нельзя; дальнейшие налоги зависят от статуса и выбранного режима.',
          },
        },
        {
          '@type': 'Question',
          name: 'Что будет при превышении лимита 2,4 млн ₽?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Право на НПД утрачивается со дня превышения лимита. Дальнейшие действия зависят от того, зарегистрированы ли вы как ИП. Уточните порядок перехода в ФНС.',
          },
        },
        {
          '@type': 'Question',
          name: 'Как оценить доход до конца года?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Выберите последний полностью учтённый месяц и укажите ожидаемый доход за месяц. Прогноз добавляет этот доход за оставшиеся месяцы к уже полученной сумме. Это ориентир при равномерном доходе, а не отдельный месячный лимит.',
          },
        },
      ],
    },
  },
];

---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  heading="Сколько ещё можно заработать?"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p slot="subtitle">
    Укажите доход от самозанятости с 1 января. Покажем, сколько осталось до годового лимита 2,4 млн ₽.
  </p>

  <section class="mt-8">
    <fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Инструмент расчёта"><IncomeLimitCalculator client:load /></fieldset><noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript>
  </section>
</CalculatorLayout>
