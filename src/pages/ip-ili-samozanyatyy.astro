---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { IpVsSamozanyatyCalculator } from '../components/react/calculators/IpVsSamozanyatyCalculator';

const title = 'НПД или УСН 6% — сравнение налогов 2026';
const description = 'Сравните ориентировочную нагрузку НПД и ИП на УСН 6% без работников';
const url = '/ip-ili-samozanyatyy';
const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'НПД или УСН 6%' },
];

const structuredData = [
  {
    type: 'FAQPage' as const,
    data: {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Что выгоднее: НПД или УСН 6%?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Зависит от дохода и типа клиентов. При доходе до 2,4 млн ₽ от физлиц самозанятый обычно выгоднее (4% НПД без взносов). При доходе свыше 2,4 млн ₽ НПД нельзя применять ко всей годовой сумме; выбор другого режима требует отдельной проверки.',
          },
        },
        {
          '@type': 'Question',
          name: 'Какие фиксированные взносы платит ИП?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'В 2026 году фиксированные взносы ИП составляют 57 390 ₽. Плюс 1% с дохода свыше 300 000 ₽ (максимум 321 818 ₽). ИП без сотрудников уменьшает налог УСН 6% на учитываемые взносы, но не ниже нуля. Взносы при этом остаются расходом.',
          },
        },
      ],
    },
  },
];

---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  heading="НПД или УСН 6% — что выгоднее"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p slot="subtitle">
    Введите годовой доход и сравните, сколько уйдёт на налоги и взносы в каждом случае.
  </p>

  <section class="mt-8">
    <fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Инструмент расчёта"><IpVsSamozanyatyCalculator client:load /></fieldset><noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript>
  </section>

  <section class="mt-10">
    <details class="group rounded-[var(--radius-card)] border border-line bg-surface">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-ink select-none">
        Какие параметры учитываются?
      </summary>
      <div class="px-4 pb-4 text-sm text-muted leading-relaxed">
        <ul class="list-disc list-inside space-y-1">
          <li>Фиксированные взносы ИП: 57 390 ₽</li>
          <li>Доп. взносы: 1% свыше 300 000 ₽ (макс. 321 818 ₽)</li>
          <li>НПД: 4% / 6% (без взносов, без отчётности)</li>
          <li>УСН 6% без сотрудников — налог уменьшается на учитываемые взносы, но не ниже нуля. Сами взносы тоже входят в нагрузку</li>
        </ul>
      </div>
    </details>
  </section>
</CalculatorLayout>
