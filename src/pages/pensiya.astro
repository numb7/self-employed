---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { PensionCalculator } from '../components/react/calculators/PensionCalculator';

const title = 'Пенсионный стаж самозанятого — стоимость взносов 2026';
const description = 'Рассчитайте стоимость добровольных пенсионных взносов для самозанятых. Стоимость полного 2026 года — 71 525,52 ₽.';
const url = '/pensiya';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Пенсионный стаж' },
];

const structuredData = [{
  type: 'FAQPage' as const,
  data: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Сколько стоит 1 год пенсионного стажа для самозанятого?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'В 2026 году добровольный взнос в СФР за полный год составляет 71 525,52 ₽.',
        },
      },
      {
        '@type': 'Question',
        name: 'Обязателен ли пенсионный взнос для самозанятых?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Нет, НПД сам по себе не формирует пенсионный стаж. Для этой деятельности взносы добровольные. Стаж по другим основаниям, например по трудовому договору, учитывается отдельно.',
        },
      },
    ],
  },
}];

---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  heading="Сколько стоит пенсионный стаж?"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p class="text-muted" slot="subtitle">
    НПД сам по себе не формирует пенсионный стаж. Стаж по другим основаниям, например по трудовому договору, учитывается отдельно.
    Можно платить добровольно: минимальный взнос за полный 2026 год — 71 525,52 ₽.
  </p>

  <section class="mt-8">
    <fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Инструмент расчёта"><PensionCalculator client:load /></fieldset><noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript>
  </section>
</CalculatorLayout>
