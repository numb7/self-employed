---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { PensionCalculator } from '../components/react/calculators/PensionCalculator';
import RelatedTools from '../components/astro/RelatedTools.astro';

const title = 'Пенсионный стаж самозанятого — стоимость взносов 2026';
const description = 'Рассчитайте стоимость добровольных пенсионных взносов для самозанятых. Стоимость полного 2026 года — 71 525,52 ₽.';
const url = '/pensiya';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Пенсионный стаж' },
];

const structuredData = [{
  type: 'FAQPage' as const,
  data: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Сколько стоит 1 год пенсионного стажа для самозанятого?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'В 2026 году добровольный взнос в СФР за полный год составляет 71 525,52 ₽.',
        },
      },
      {
        '@type': 'Question',
        name: 'Обязателен ли пенсионный взнос для самозанятых?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Нет, пенсионные взносы для самозанятых на НПД добровольные. Без них пенсионный стаж не идёт.',
        },
      },
    ],
  },
}];

const relatedTools = [
  { title: 'Взносы на больничный', description: 'Социальное страхование', url: '/bolnichny' },
  { title: 'Сколько налога заплатить', description: 'Калькулятор НПД', url: '/otlozhit-na-nalog' },
  { title: 'ИП или самозанятый', description: 'Сравнение нагрузки', url: '/ip-ili-samozanyatyy' },
];
---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p class="text-muted" slot="subtitle">
    Самозанятые на НПД не обязаны платить пенсионные взносы — стаж не копится.
    Можно платить добровольно: стоимость полного 2026 года — 71 525,52 ₽.
  </p>

  <section class="mt-8">
    <PensionCalculator client:load />
  </section>

  <section class="mt-10">
    <details class="group">
      <summary class="cursor-pointer font-head text-sm font-medium text-muted hover:text-ink transition-colors select-none">
        Как считается: откуда цифры
      </summary>
      <div class="prose mt-4 text-sm">
        <p>Добровольные взносы в СФР для самозанятых рассчитываются пропорционально количеству месяцев. За полный 2026 год — 71 525,52 ₽ по формуле 22% × 12 × МРОТ.</p>
        <p>Взносы можно платить за любой период: 1 месяц, полгода или год.</p>
        <p>Расчёт ориентировочный. <a href="/metodika">Подробнее о методике →</a></p>
        <ul class="mt-2">
          <li>Постановление Правительства РФ о размере фиксированных взносов на 2026</li>
          <li><a href="https://sfr.gov.ru" target="_blank" rel="noopener noreferrer">sfr.gov.ru</a> — Социальный фонд России</li>
        </ul>
      </div>
    </details>
  </section>

  <RelatedTools tools={relatedTools} currentUrl={url} />
</CalculatorLayout>
