---
import { HomeTaxCalculator } from '../components/react/calculators/HomeTaxCalculator';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Помощник самозанятого — сколько отложить на налог и что делать дальше';
const description = 'Рассчитайте налог с оплаты, проверьте лимит дохода и подготовьте договор. Понятные инструменты для самозанятых, бесплатно и без регистрации.';
const tasks = [
 {title:'Сколько ещё можно заработать?',desc:'Проверьте, сколько осталось до годового лимита 2,4 млн ₽.',href:'/limit-dohoda',kind:'limit'},
 {title:'Какую цену назвать клиенту?',desc:'Рассчитайте ставку за час с учётом налога.',href:'/stavka-v-chas',kind:'price'},
 {title:'Заказчик просит договор?',desc:'Заполните шаблон договора или акта и скачайте документ.',href:'/dogovor-akt',kind:'document'},
];
const extra = [
 {name:'Налоги и выбор режима',tools:[{title:'Как работает налоговый бонус',href:'/vychet-10000'},{title:'Сравнить налоги самозанятого и ИП',href:'/ip-ili-samozanyatyy'},{title:'Мне подходит самозанятость?',href:'/master-vybora-rezhima'}]},
 {name:'Работа с заказчиками',tools:[{title:'Похоже ли сотрудничество на работу по найму?',href:'/risk-trudovyh'},{title:'Слишком много дохода от одного клиента?',href:'/koncentracia-dohoda'},{title:'Работаю через платформу — что проверить?',href:'/chasy-289-fz'}]},
 {name:'Пенсия и больничный',tools:[{title:'Сколько стоит пенсионный стаж',href:'/pensiya'},{title:'Сколько платить за страхование больничного',href:'/bolnichny'}]},
];
---
<BaseLayout title={title} description={description} url="/" navVariant="home" structuredData={[{type:'WebSite',data:{'@context':'https://schema.org','@type':'WebSite',name:'НПД.помощник',url:'https://samozanyatye.vercel.app',inLanguage:'ru'}}]}>
  <section class="clear-hero container">
    <div class="clear-intro">
      <span class="clear-eyebrow">Помощник самозанятого</span>
      <h1>Работайте на себя.<br/><em>С цифрами поможем.</em></h1>
      <p>Получили оплату? Узнайте, сколько оставить на налог, а сколько останется вам.</p>
      <a href="#home-tax" class="clear-start">Посчитать с моей суммы <span aria-hidden="true">↗</span></a>
      <span class="clear-free">Бесплатно · Без регистрации</span>
      <div class="clear-intro-foot"><span class="identity-split" aria-hidden="true"></span><span>Меньше считать.<br/>Больше заниматься своим делом.</span></div>
    </div>
    <section class="clear-workbench" id="home-tax" aria-labelledby="tax-title"><h2 id="tax-title">Сколько оставить на налог?</h2><fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Инструмент расчёта"><HomeTaxCalculator client:load /></fieldset><noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript></section>
  </section>
  <section class="clear-next container" aria-labelledby="next-title">
    <h2 id="next-title">Оплату получили. Что дальше?</h2>
    <p>Если чек уже сформировал банк или платформа, повторно создавать его не нужно.</p>
    <ol><li><span aria-hidden="true">1</span><div><strong>Оформите чек</strong><p>В «Мой налог» или сервисе, через который ведёте самозанятость. Отправьте его заказчику.</p></div></li><li><span aria-hidden="true">2</span><div><strong>Оставьте деньги на налог</strong><p>Калькулятор выше поможет оценить сумму с этой оплаты.</p></div></li><li><span aria-hidden="true">3</span><div><strong>Проверьте начисление</strong><p>Итог за месяц появится в «Мой налог». Обычный срок уплаты — до 28-го числа следующего месяца.</p></div></li></ol>
    <a href="https://npd.nalog.ru/" target="_blank" rel="noopener noreferrer">Как это работает — на сайте ФНС ↗</a>
  </section>
  <section class="clear-tasks container" id="tools" aria-labelledby="tasks-title"><span id="tasks-anchor"></span><h2 id="tasks-title">С чем ещё помочь?</h2><div class="clear-task-grid">{tasks.map(task => <a class={`clear-task task-${task.kind}`} href={task.href}><div class="task-art" aria-hidden="true">{task.kind==='limit'?<svg viewBox="0 0 96 70" fill="none"><path d="M8 55h80M12 55V43m18 12V33m18 22V23m18 32V13m18 42V3"/><path class="art-accent" d="M8 55h45M53 49v12"/></svg>:task.kind==='price'?<svg viewBox="0 0 96 70" fill="none"><circle cx="48" cy="35" r="28"/><path d="M48 14v21l14 8M48 3v6m0 52v6M16 35h6m52 0h6"/><path class="art-accent" d="M48 7a28 28 0 0 1 28 28"/></svg>:<svg viewBox="0 0 96 70" fill="none"><path d="M27 6h34l12 12v46H27zM61 6v14h12M35 31h29M35 40h29M35 49h17"/><path class="art-accent" d="m52 56 4 4 13-14"/></svg>}</div><h3>{task.title}</h3><p>{task.desc}</p><span class="task-arrow" aria-hidden="true">↗</span></a>)}</div>
    <details class="clear-more"><summary>Другие вопросы: налоги, заказчики, пенсия <span aria-hidden="true">+</span></summary><div class="clear-extra-grid">{extra.map(group=><section><h3>{group.name}</h3>{group.tools.map(tool=><a href={tool.href}>{tool.title}<span aria-hidden="true">↗</span></a>)}</section>)}</div><a class="clear-tax-link" href="/poleznoe">Самозанятость простыми словами ↗</a><br/><a class="clear-tax-link" href="/otlozhit-na-nalog">Открыть налоговый калькулятор отдельной страницей ↗</a></details>
  </section>
</BaseLayout>
