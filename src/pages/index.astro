---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Финансовый помощник для самозанятых — налог, лимит, риски и документы';
const description = 'Калькуляторы для самозанятых: налог 4% и 6%, лимит дохода 2,4 млн ₽, ставка в час, риск переквалификации, договор и акт. Расчёты выполняются на устройстве.';
const url = '/';

/* ── Сценарные карточки ── */
const scenarios = [
  {
    title: 'Мне пришла оплата',
    hint: 'Узнайте, сколько отложить на налог.',
    href: '/otlozhit-na-nalog',
  },
  {
    title: 'Боюсь превысить лимит',
    hint: 'Проверьте, сколько осталось до 2,4 млн ₽.',
    href: '/limit-dohoda',
  },
  {
    title: 'Не знаю, ИП или самозанятость',
    hint: 'Интерактивный помощник под ваши условия.',
    href: '/master-vybora-rezhima',
  },
  {
    title: 'Работаю с одним заказчиком',
    hint: 'Оцените риск переквалификации.',
    href: '/risk-trudovyh',
  },
  {
    title: 'Нужно оформить документы',
    hint: 'Готовый шаблон договора и акта.',
    href: '/dogovor-akt',
  },
  {
    title: 'Хочу рассчитать ставку',
    hint: 'Узнайте ставку до и после налога.',
    href: '/stavka-v-chas',
  },
];

/* ── Главные калькуляторы ── */
const featured = [
  {
    title: 'Отложить на налог',
    desc: 'Сколько отложить с каждой оплаты — 4% или 6%.',
    example: 'с 30\u00a0000\u00a0₽ → отложить 1\u00a0200\u00a0₽',
    href: '/otlozhit-na-nalog',
  },
  {
    title: 'Лимит дохода',
    desc: 'Сколько ещё можно заработать до конца года.',
    example: 'осталось 1\u00a0200\u00a0000\u00a0₽ из 2\u00a0400\u00a0000\u00a0₽',
    href: '/limit-dohoda',
  },
  {
    title: 'ИП или самозанятый',
    desc: 'Сравните налоговую нагрузку по режимам.',
    example: 'НПД: 96\u00a0000\u00a0₽ · ИП УСН: 144\u00a0000\u00a0₽',
    href: '/master-vybora-rezhima',
  },
];

/* ── Категории инструментов ── */
const categories = [
  {
    name: 'Деньги',
    tools: [
      { title: 'Отложить на налог', desc: '4% с физлиц или 6% с юрлиц', href: '/otlozhit-na-nalog' },
      { title: 'Лимит дохода', desc: 'До 2,4 млн ₽ в год', href: '/limit-dohoda' },
      { title: 'Вычет 10 000 ₽', desc: 'Снижает ставку на 1–2 п.п.', href: '/vychet-10000' },
      { title: 'Ставка в час', desc: 'Сколько просить и сколько получать', href: '/stavka-v-chas' },
    ],
  },
  {
    name: 'Риски',
    tools: [
      { title: 'Риск переквалификации', desc: 'Чек-лист признаков трудовых отношений', href: '/risk-trudovyh' },
      { title: 'Концентрация дохода', desc: 'Зависимость от одного заказчика', href: '/koncentracia-dohoda' },
      { title: 'Часы по 289-ФЗ', desc: '60 часов/мес на одного заказчика', href: '/chasy-289-fz' },
    ],
  },
  {
    name: 'Документы и режим',
    tools: [
      { title: 'Договор и акт', desc: 'Готовый шаблон для банка', href: '/dogovor-akt' },
      { title: 'ИП или самозанятый', desc: 'Сравнение нагрузки по режимам', href: '/ip-ili-samozanyatyy' },
      { title: 'Мастер выбора режима', desc: 'Интерактивный помощник', href: '/master-vybora-rezhima' },
    ],
  },
  {
    name: 'Соцзащита',
    tools: [
      { title: 'Пенсионный стаж', desc: 'Стоимость 1 года стажа', href: '/pensiya' },
      { title: 'Взносы на больничный', desc: 'Добровольные взносы в СФР', href: '/bolnichny' },
    ],
  },
];

/* ── FAQ ── */
const faqItems = [
  {
    q: 'Можно ли использовать сервис вместо бухгалтера?',
    a: 'Сервис помогает с предварительными расчётами — налог, лимит, ставки, риски. Он не заменяет бухгалтера или юриста, но даёт быструю ориентировочную цифру для повседневных решений.',
  },
  {
    q: 'Сколько налога платит самозанятый?',
    a: 'Ставка НПД: 4% с доходов от физлиц и 6% от юрлиц и ИП. Налог не удерживается автоматически — вы получаете всю сумму и сами откладываете часть. Срок уплаты — до 28-го числа следующего месяца.',
    link: { text: 'Калькулятор «Отложить на налог» →', href: '/otlozhit-na-nalog' },
  },
  {
    q: 'Какой лимит дохода у самозанятых?',
    a: '2 400 000 ₽ в год. При превышении лимита статус самозанятого теряется с начала месяца превышения — нужно переходить на ИП или другой налоговый режим.',
    link: { text: 'Калькулятор лимита дохода →', href: '/limit-dohoda' },
  },
  {
    q: 'Что будет, если превысить лимит?',
    a: 'Статус НПД аннулируется с первого дня месяца, в котором превышен лимит. Нужно перейти на другой режим налогообложения (например, ИП на УСН). Доходы после превышения облагаются по правилам нового режима.',
  },
  {
    q: 'Чем самозанятый отличается от ИП?',
    a: 'Самозанятый платит 4–6% НПД без обязательных взносов. ИП на УСН платит 6% с доходов или 15% с разницы между доходами и расходами, плюс обязательные страховые взносы — 57 390 ₽ в 2026 году. ИП нужен при доходе выше 2,4 млн ₽, найме сотрудников и для видов деятельности, недоступных на НПД.',
    link: { text: 'Сравнить режимы →', href: '/ip-ili-samozanyatyy' },
  },
  {
    q: 'Безопасно ли вводить данные на сайте?',
    a: 'Да. Все расчёты выполняются прямо в вашем браузере — данные не отправляются на сервер. Сервис не хранит, не передаёт и не обрабатывает вашу финансовую информацию где-либо, кроме вашего устройства.',
  },
];

/* ── JSON-LD ── */
const structuredData = [
  {
    type: 'WebSite',
    data: {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Финансовый помощник для самозанятых',
      description: 'Калькуляторы и инструменты для самозанятых в России 2026',
      url: 'https://npd-tools.ru',
      inLanguage: 'ru',
      dateModified: '2026-08-06',
    },
  },
  {
    type: 'Organization',
    data: {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'NPD помощник',
      url: 'https://npd-tools.ru',
      description: 'Бесплатные калькуляторы для самозанятых в России',
    },
  },
  {
    type: 'FAQPage',
    data: {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  url={url}
  navVariant="home"
  structuredData={structuredData}
>

  <!-- ═══════════════════════════════════════════
       1. Hero
       ═══════════════════════════════════════════ -->
  <section class="hero">
    <div class="container">
      <span class="hero__eyebrow">Помощник самозанятого</span>
      <h1 class="hero__title font-head">
        Финансовый помощник для самозанятых
      </h1>
      <p class="hero__subtitle text-muted">
        Посчитайте налог, лимит дохода, ставку, риски и взносы для быстрой самопроверки.
      </p>

      <div class="hero__cta mt-6 flex flex-wrap gap-3">
        <a
          href="/otlozhit-na-nalog"
          class="hero__cta-primary inline-flex items-center gap-2 rounded-[var(--radius-card)] bg-accent px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-2"
        >
          Рассчитать налог
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href="#tools"
          class="hero__cta-secondary inline-flex items-center gap-2 rounded-[var(--radius-card)] border border-line bg-surface px-5 py-3 text-sm font-medium text-ink transition-colors hover:bg-lavender"
        >
          Выбрать инструмент
        </a>
      </div>

      <div class="hero__trust mt-6 flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-muted">
        <span>Ставки: <strong class="text-ink">ФНС · 4% / 6%</strong></span>
        <span class="text-faint hidden sm:inline" aria-hidden="true">·</span>
        <span>Лимит: <strong class="text-ink">2,4 млн ₽</strong></span>
        <span class="text-faint hidden sm:inline" aria-hidden="true">·</span>
        <span>Данные: <strong class="text-ink">только на устройстве</strong></span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       2. Что у вас сейчас?
       ═══════════════════════════════════════════ -->
  <section class="container mt-12" id="scenarios">
    <h2 class="font-head text-[var(--fs-h2)] font-medium text-ink">Что у вас сейчас?</h2>
    <p class="mt-2 text-sm text-muted max-w-xl">
      Выберите свою ситуацию — сервис подскажет нужный инструмент.
    </p>

    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {scenarios.map(s => (
        <a
          href={s.href}
          class="scenario-card group flex items-start gap-3 rounded-[var(--radius-card)] border border-line bg-surface p-5 transition-colors hover:bg-lavender"
        >
          <div class="flex-1 min-w-0">
            <span class="scenario-card__title font-head text-sm font-medium text-ink group-hover:text-accent transition-colors">
              {s.title}
            </span>
            <span class="mt-1 block text-xs text-muted leading-relaxed">{s.hint}</span>
          </div>
          <svg class="scenario-card__arrow w-4 h-4 text-faint group-hover:text-accent transition-colors flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       3. Главные калькуляторы
       ═══════════════════════════════════════════ -->
  <section class="container mt-12">
    <h2 class="font-head text-[var(--fs-h2)] font-medium text-ink">Главные калькуляторы</h2>
    <p class="mt-2 text-sm text-muted max-w-xl">
      Самые нужные инструменты — крупнее и подробнее.
    </p>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
      {featured.map(f => (
        <a href={f.href} class="featured-card group flex flex-col rounded-[var(--radius-card)] border border-line bg-surface p-6 transition-colors hover:bg-lavender">
          <h3 class="featured-card__title font-head text-base font-medium text-ink group-hover:text-accent transition-colors">
            {f.title}
          </h3>
          <span class="featured-card__desc mt-1 text-sm text-muted leading-relaxed md:min-h-[3.5rem]">{f.desc}</span>
          <div class="featured-card__example mt-4 flex min-h-[3.5rem] items-center rounded-[var(--radius-control)] bg-accent-soft px-3 py-2">
            <span class="font-mono text-sm font-semibold text-accent">{f.example}</span>
          </div>
          <span class="featured-card__cta mt-auto pt-4 inline-flex items-center gap-1 text-sm font-medium text-accent">
            Перейти к расчёту
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       4. Все инструменты по категориям
       ═══════════════════════════════════════════ -->
  <section class="container mt-12" id="tools">
    <h2 class="font-head text-[var(--fs-h2)] font-medium text-ink">Все инструменты</h2>
    <p class="mt-2 text-sm text-muted max-w-xl">
      Сгруппированы по задачам — деньги, риски, документы и соцзащита.
    </p>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
      {categories.map(cat => (
        <div class="category">
          <h3 class="category__name font-head text-sm font-semibold text-ink uppercase tracking-wider mb-3">
            {cat.name}
          </h3>
          <div class="flex flex-col gap-2">
            {cat.tools.map(tool => (
              <a
                href={tool.href}
                class="category__tool group flex items-center gap-3 rounded-[var(--radius-card)] border border-line bg-surface px-4 py-3 transition-colors hover:bg-lavender"
              >
                <span class="flex-1 min-w-0">
                  <span class="category__tool-title text-sm font-medium text-ink group-hover:text-accent transition-colors">
                    {tool.title}
                  </span>
                  <span class="ml-2 text-xs text-muted">{tool.desc}</span>
                </span>
                <svg class="category__tool-arrow w-3.5 h-3.5 text-faint group-hover:text-accent transition-colors flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       5. Как это работает
       ═══════════════════════════════════════════ -->
  <section class="container mt-16" id="how-anchor">
    <h2 class="font-head text-[var(--fs-h2)] font-medium text-ink">Как это работает</h2>

    <ol class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-6">
      <li class="flex gap-4">
        <span class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-accent-soft text-accent font-mono text-sm font-semibold">1</span>
        <div>
          <span class="block font-head text-sm font-medium text-ink">Выберите, что хотите посчитать</span>
          <span class="mt-1 block text-xs text-muted leading-relaxed">Например, налог, лимит дохода или риск работы с одним заказчиком.</span>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-accent-soft text-accent font-mono text-sm font-semibold">2</span>
        <div>
          <span class="block font-head text-sm font-medium text-ink">Укажите исходные данные</span>
          <span class="mt-1 block text-xs text-muted leading-relaxed">Все расчёты происходят прямо в браузере.</span>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-accent-soft text-accent font-mono text-sm font-semibold">3</span>
        <div>
          <span class="block font-head text-sm font-medium text-ink">Получите понятный результат</span>
          <span class="mt-1 block text-xs text-muted leading-relaxed">Сервис покажет главное число, краткое объяснение и следующий шаг.</span>
        </div>
      </li>
    </ol>
  </section>

  <!-- ═══════════════════════════════════════════
       6. Блок доверия
       ═══════════════════════════════════════════ -->
  <section class="container mt-16">
    <div class="trust-block rounded-[var(--radius-card)] border border-line bg-surface px-6 py-8">
      <h2 class="font-head text-[var(--fs-h3)] font-medium text-ink text-center">Как устроены расчёты</h2>
      <ul class="mt-5 flex flex-col sm:flex-row flex-wrap items-start justify-center gap-x-8 gap-y-3 text-sm text-muted">
        <li class="trust-block__item flex items-center gap-2">
          <svg class="trust-block__check w-4 h-4 text-green flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          Без регистрации
        </li>
        <li class="trust-block__item flex items-center gap-2">
          <svg class="trust-block__check w-4 h-4 text-green flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          Без отправки данных
        </li>
        <li class="trust-block__item flex items-center gap-2">
          <svg class="trust-block__check w-4 h-4 text-green flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          По правилам НПД 2026
        </li>
        <li class="trust-block__item flex items-center gap-2">
          <svg class="trust-block__check w-4 h-4 text-green flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          Для самопроверки
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       7. FAQ
       ═══════════════════════════════════════════ -->
  <section class="container mt-16">
    <h2 class="font-head text-[var(--fs-h2)] font-medium text-ink">Частые вопросы</h2>

    <div class="mt-4 flex flex-col gap-3">
      {faqItems.map(item => (
        <details class="faq-item group rounded-[var(--radius-card)] border border-line bg-surface">
          <summary class="cursor-pointer px-5 py-4 font-head text-sm font-medium text-ink hover:text-accent transition-colors select-none">
            {item.q}
          </summary>
          <div class="accordion-content px-5 pb-4 text-sm text-muted leading-relaxed">
            <p>{item.a}</p>
            {item.link && (
              <a href={item.link.href} class="mt-2 inline-block text-accent hover:underline">{item.link.text}</a>
            )}
          </div>
        </details>
      ))}
    </div>

    <div class="mt-4">
      <a href="/poleznoe" class="text-sm text-accent hover:underline">Все вопросы и гайды →</a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       8. Дисклеймер
       ═══════════════════════════════════════════ -->
  <section class="container mt-16 mb-16">
    <p class="disclaimer text-xs text-muted text-center max-w-2xl mx-auto leading-relaxed">
      Сервис помогает сделать предварительный расчёт и не является официальным сервисом ФНС, СФР, бухгалтерской или юридической консультацией. Перед принятием важных решений проверяйте актуальные правила в официальных источниках.
    </p>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding-top: clamp(2.5rem, 8vw, 5rem);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .hero__eyebrow {
    font-size: var(--fs-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    font-weight: 600;
    display: block;
    margin-bottom: 0.75rem;
  }
  .hero__title {
    font-size: var(--fs-hero);
    line-height: 1.15;
    color: var(--color-ink);
    max-width: 32rem;
  }
  .hero__subtitle {
    font-size: var(--fs-body);
    line-height: 1.6;
    max-width: 36rem;
    margin-top: 1.25rem;
  }
  .hero__cta-primary,
  .hero__cta-primary:hover {
    color: #fff;
  }

  /* ── Scenario cards ── */
  .scenario-card {
    text-decoration: none;
  }

  /* ── Featured cards ── */
  .featured-card {
    text-decoration: none;
  }

  /* ── Category tools ── */
  .category__name {
    margin-bottom: 0.75rem;
  }
  .category__tool {
    text-decoration: none;
  }
</style>
