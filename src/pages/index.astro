---
import { HomeTaxCalculator } from '../components/react/calculators/HomeTaxCalculator';
import ToolArtwork from '../components/astro/ToolArtwork.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Помощник самозанятого — налоги, цена работы и документы';
const description = 'Рассчитайте налог с оплаты, проверьте лимит дохода и подготовьте договор. Понятные инструменты для самозанятых.';
const tasks = [
 {title:'Проверить лимит дохода',desc:'Проверьте, сколько осталось до годового лимита 2,4 млн ₽.',href:'/limit-dohoda',kind:'limit'},
 {title:'Рассчитать цену часа',desc:'Рассчитайте ставку за час с учётом налога.',href:'/stavka-v-chas',kind:'price'},
 {title:'Подготовить договор',desc:'Заполните шаблон договора или акта и скачайте документ.',href:'/dogovor-akt',kind:'document'},
];
const extra = [
 {name:'Налоги и выбор режима',tools:[{title:'Как работает налоговый бонус',href:'/vychet-10000'},{title:'Сравнить налоги самозанятого и ИП',href:'/ip-ili-samozanyatyy'},{title:'Мне подходит самозанятость?',href:'/master-vybora-rezhima'}]},
 {name:'Работа с заказчиками',tools:[{title:'Похоже ли сотрудничество на работу по найму?',href:'/risk-trudovyh'},{title:'Слишком много дохода от одного клиента?',href:'/koncentracia-dohoda'},{title:'Работаю через платформу — что проверить?',href:'/chasy-289-fz'}]},
 {name:'Пенсия и больничный',tools:[{title:'Сколько стоит пенсионный стаж',href:'/pensiya'},{title:'Сколько платить за страхование больничного',href:'/bolnichny'}]},
];
---
<BaseLayout title={title} description={description} url="/" navVariant="home" structuredData={[{type:'WebSite',data:{'@context':'https://schema.org','@type':'WebSite',name:'НПД.помощник',url:'https://samozanyatye.vercel.app',inLanguage:'ru'}}]}>
  <section class="desk container" id="tools" aria-labelledby="desk-title">
    <header class="desk-intro">
      <h1 id="desk-title"><span class="title-line"><span>Деньги</span></span><span class="title-line"><span>вашего дела.</span></span></h1>
      <p>Помощник самозанятого: посчитайте налог, проверьте лимит и оформите работу с заказчиком.</p>
    </header>
    <section class="desk-calculator" id="home-tax" aria-labelledby="tax-title">
      <div class="desk-calculator-heading"><h2 id="tax-title">Налог с оплаты</h2></div>
      <fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Расчёт налога с оплаты"><HomeTaxCalculator client:load /></fieldset>
      <noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript>
    </section>
    <nav class="desk-tools" aria-label="Другие основные задачи">
      {tasks.map(task=><a href={task.href}><ToolArtwork kind={task.kind}/><div><h2>{task.title}</h2><p>{task.desc}</p></div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>)}
    </nav>
  </section>
  <section class="desk-library container" aria-label="Все инструменты">
    <details class="clear-more"><summary>Другие инструменты <span aria-hidden="true">+</span></summary><div class="clear-extra-grid">{extra.map(group=><section><h2>{group.name}</h2>{group.tools.map(tool=><a href={tool.href}>{tool.title}</a>)}</section>)}</div></details>
  </section>
  <section class="clear-next container" aria-labelledby="next-title">
    <h2 id="next-title">Оплату получили. Что дальше?</h2>
    <p>Если чек уже сформировал банк или платформа, повторно создавать его не нужно.</p>
    <ol><li><span aria-hidden="true">1</span><div><strong>Оформите чек</strong><p>В «Мой налог» или сервисе, через который ведёте самозанятость. Отправьте его заказчику.</p></div></li><li><span aria-hidden="true">2</span><div><strong>Оставьте деньги на налог</strong><p>Калькулятор выше поможет оценить сумму с этой оплаты.</p></div></li><li><span aria-hidden="true">3</span><div><strong>Проверьте начисление</strong><p>Итог за месяц появится в «Мой налог». Обычный срок уплаты — до 28-го числа следующего месяца.</p></div></li></ol>
    <a href="https://npd.nalog.ru/" target="_blank" rel="noopener noreferrer">Как это работает — на сайте ФНС ↗</a>
  </section>
</BaseLayout>
