---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import { RiskTrudovyhCalculator } from '../components/react/calculators/RiskTrudovyhCalculator';

const title = 'Риск переквалификации ГПХ в трудовые — чек-лист';
const description = 'Оцените риск переквалификации договора ГПХ в трудовой по 13 признакам ФНС и судов. Чек-лист и индикатор риска для самозанятых.';
const url = '/risk-trudovyh';
const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Калькуляторы', url: '/#tasks-anchor' },
  { name: 'Риск переквалификации' },
];

const structuredData = [
  {
    type: 'FAQPage' as const,
    data: {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Что такое переквалификация ГПХ в трудовой договор?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Это когда налоговая или суд признают договор ГПХ с самозанятым трудовым отношением. Тогда возможны доначисления НДФЛ, страховых взносов, пеней и штрафов. Их размер зависит от обстоятельств.',
          },
        },
        {
          '@type': 'Question',
          name: 'Какие признаки проверяет ФНС для переквалификации?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Чек-лист содержит 13 возможных признаков: один заказчик, работа из офиса, заданный график, типовой договор, чужое оборудование, длительные отношения, подчинение распорядку, отпуск и больничные, непрерывность работы, интеграция в штат, те же обязанности что и у сотрудников, периодическая оплата, оплата за процесс.',
          },
        },
        {
          '@type': 'Question',
          name: 'Как снизить риск переквалификации?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Описывайте в договоре конкретную услугу или результат. Условия и фактическая работа должны соответствовать гражданскому договору. Универсальной безопасной доли дохода от одного клиента нет.',
          },
        },
      ],
    },
  },
];

---

<CalculatorLayout
  title={title}
  description={description}
  url={url}
  heading="Сотрудничество или работа по найму?"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <p slot="subtitle">
    Проверьте, нет ли в вашей работе признаков трудовых отношений. Этот чек-лист поможет заметить вопросы, которые стоит обсудить с юристом.
  </p>

  <section class="mt-8">
    <fieldset class="calculator-ready" data-calculator-loading disabled aria-busy="true" aria-label="Инструмент расчёта"><RiskTrudovyhCalculator client:load /></fieldset><noscript><p>Чтобы пользоваться инструментом, включите JavaScript в браузере.</p></noscript>
  </section>

  <section class="mt-10">
    <details class="group rounded-[var(--radius-card)] border border-line bg-surface">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-ink select-none">
        Как это оценивается?
      </summary>
      <div class="px-4 pb-4 text-sm text-muted leading-relaxed">
        Чек-лист содержит возможные признаки трудовых отношений. Баллы и пороги — ориентиры этого сервиса, а не правила ФНС. Сам по себе один заказчик или большая доля дохода от него не определяет правовой статус отношений. Оценивается совокупность обстоятельств.
      </div>
    </details>
  </section>
</CalculatorLayout>
